# === Platform-level settings ===
# Everything in this file is shared infrastructure for the whole service, paid for
# and configured by the operator - never shown to or editable by end users. Each
# user's own Instagram account is connected separately via OAuth (Settings ->
# Connect Instagram), not configured here.

# LLM provider for AI content strategy (Plan 2): "anthropic" or "groq".
LLM_PROVIDER=anthropic

# Anthropic (used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq (used if LLM_PROVIDER=groq) - free/low-cost, fast inference on open models.
# Verify current model names for your account with `client.models.list()` or at
# https://console.groq.com/docs/models - Groq's catalog changes over time and the
# default below can go stale (it was confirmed working as of this setup).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Video engine (Plan 2): "broll" (free: stock footage + AI voiceover + captions,
# default) or "heygen" (paid: AI avatar video).
VIDEO_ENGINE=broll

# Pexels (free stock footage, used by the "broll" video engine)
PEXELS_API_KEY=

# HeyGen (AI avatar / text-to-video generation, used only if VIDEO_ENGINE=heygen)
HEYGEN_API_KEY=

# Meta Developer App - the platform's own app used for every user's Instagram
# OAuth connect flow (Business Login for Instagram). Add the redirect URI below
# to this app's "Valid OAuth Redirect URIs" in the Instagram product settings.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8000/api/instagram/callback

# Object storage for hosting generated/uploaded videos (S3-compatible: AWS S3 or
# Cloudflare R2) - shared bucket, objects are prefixed per-user internally.
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_REGION=auto

# App settings
DATABASE_URL=sqlite:///./data/app.db
VIDEO_GEN_LEAD_DAYS=2
MAX_AUTO_RETRIES=2

# Random string used to sign user session cookies and OAuth state tokens - e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=
