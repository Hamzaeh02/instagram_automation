# LLM provider for content strategy (90-day calendar, scripts, captions, hashtags,
# titles): "anthropic" or "groq". Only the selected provider's key is required.
LLM_PROVIDER=anthropic

# Anthropic (used if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq (used if LLM_PROVIDER=groq) - free/low-cost, fast inference on open models.
# Verify current model names for your account with `client.models.list()` or at
# https://console.groq.com/docs/models - Groq's catalog changes over time and the
# default below can go stale (it was confirmed working as of this setup).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Video engine: "broll" (free: stock footage + AI voiceover + captions, default)
# or "heygen" (paid: AI avatar video). Both are implemented; this just picks which runs.
VIDEO_ENGINE=broll

# Pexels (free stock footage, used by the "broll" video engine)
PEXELS_API_KEY=

# HeyGen (AI avatar / text-to-video generation, used only if VIDEO_ENGINE=heygen)
HEYGEN_API_KEY=

# Instagram API with Instagram Login (no Facebook Page needed - direct login
# with your Instagram professional account via Business Login for Instagram)
META_APP_ID=
META_APP_SECRET=
IG_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v25.0

# Object storage for hosting generated videos (S3-compatible: AWS S3 or Cloudflare R2)
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_REGION=auto

# App settings
DATABASE_URL=sqlite:///./data/app.db
BRAND_CONFIG_PATH=./config/brand.yaml
TIMEZONE=UTC
VIDEO_GEN_LEAD_DAYS=2
MAX_AUTO_RETRIES=2

# Dashboard (web UI at http://<host>:8000 once scripts/run_server.py is running -
# this is also where you review and approve/reject generated content)
DASHBOARD_PASSWORD=
SESSION_SECRET=
