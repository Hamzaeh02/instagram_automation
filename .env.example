# === Platform-level settings ===
# Everything in this file is shared infrastructure for the whole service, paid for
# and configured by the operator - never shown to or editable by end users. Each
# user's own Instagram account is connected separately via OAuth (Settings ->
# Connect Instagram), not configured here.

# Anthropic - Claude researches and writes every post (title, caption,
# hashtags, script, shot list), using live web search for trends and data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini - generates each post's image from a Claude-written prompt
# (aistudio.google.com -> Get API key; image generation needs billing on).
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=2K

# Pexels - free stock photos, used for post images only when no Gemini key is set
PEXELS_API_KEY=

# Meta Developer App - the platform's own app. META_APP_ID/SECRET below are the
# app's main (Facebook Login) credentials, used only for Facebook Page connect.
META_APP_ID=
META_APP_SECRET=

# Instagram Business Login needs a DIFFERENT credential pair than the app's
# main META_APP_ID/SECRET above - found at: App Dashboard > Instagram > API
# setup with Instagram login > "3. Set up Instagram business login" >
# Business login settings. Using META_APP_ID here fails with "Invalid
# platform app".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8000/api/instagram/callback
# Add the redirect URI above to the SAME "Business login settings" section's
# "OAuth redirect URIs" field (not the app's general Valid OAuth Redirect URIs).

# Facebook Page publishing reuses the main Meta app/credentials above - just add
# these Page permissions to it: pages_show_list, pages_manage_posts,
# pages_manage_metadata, pages_read_engagement. Add the redirect URI below to the
# app's "Valid OAuth Redirect URIs" too.
FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/facebook/callback

# LinkedIn - a separate Developer App (own Client ID/Secret, requires linking
# to a LinkedIn Company Page you administer to create the app at all - no LLC
# or business registration needed, a personal/side-project page is fine).
# Add these two products on the app's Products tab - both self-serve/instant,
# no review needed: "Sign In with LinkedIn using OpenID Connect" (identity)
# and "Share on LinkedIn" (w_member_social - posting). This posts to the
# connecting member's own profile, NOT a Company Page - Company Page posting
# needs LinkedIn's Community Management API, which requires an application
# LinkedIn reviews (commonly weeks to months), so it's intentionally not
# built here.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
LINKEDIN_API_VERSION=202608

# TikTok - a separate Developer App (Client Key/Secret, from
# developers.tiktok.com/apps). Add the "Login Kit" and "Content Posting API"
# products - both self-serve/instant, no review needed to connect and post.
# Caveat: until TikTok audits your app, every post is forced to SELF_ONLY
# (private, visible only to the poster) regardless of what's requested -
# that's enforced by TikTok server-side. Request an audit from the app's
# Content Posting API product page once you're ready for public posts.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/tiktok/callback

# X (Twitter) - a separate Developer App (developer.x.com), OAuth 2.0 Client
# ID/Secret from the app's "Keys and tokens" tab. Turn on "OAuth 2.0" under
# User authentication settings, app type "Web App", and set the callback URL
# below. Scopes used: tweet.read, tweet.write, users.read, offline.access
# (the last one is what makes X issue a refresh_token). Self-serve, no
# review needed to connect and post under the Free/Basic tier.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_OAUTH_REDIRECT_URI=http://localhost:8000/api/x/callback

# Object storage for hosting generated/uploaded videos (S3-compatible: AWS S3 or
# Cloudflare R2) - shared bucket, objects are prefixed per-user internally.
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
STORAGE_REGION=auto

# App settings
DATABASE_URL=sqlite:///./data/app.db
VIDEO_GEN_LEAD_DAYS=2
MAX_AUTO_RETRIES=2

# Random string used to sign user session cookies and OAuth state tokens - e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=
